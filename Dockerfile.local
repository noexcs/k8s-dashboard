# Offline build variant: base images pinned to locally available tags
# (docker.io 不可达时用 `docker build -f Dockerfile.local -t k8s-dashboard:dev .`；
#  网络恢复后仍用主 Dockerfile 的 digest 锁定版本)。
FROM alpine:3.20 AS image-base

FROM golang:1.26 AS backend-build
WORKDIR /headlamp

ARG GOFLAGS
ENV GOPATH=/go \
    GOPROXY=https://proxy.golang.org \
    GOFLAGS=${GOFLAGS} \
    GO111MODULE=on \
    CGO_ENABLED=0

# Keep go mod download separated from source changes
COPY ./backend/go.* /headlamp/backend/
RUN --mount=type=cache,target=/go/pkg/mod \
    cd ./backend && go mod download

COPY ./backend /headlamp/backend

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    cd ./backend && go build -o ./headlamp-server ./cmd/

FROM node:22 AS frontend-build

COPY web/package*.json /headlamp/web/
WORKDIR /headlamp
RUN cd ./web && npm ci

# AI 执行层构建：ai-exec 纯 JS 依赖（pi SDK + typebox），npm ci 产物即运行目录
FROM node:22 AS ai-exec-build
WORKDIR /opt/ai-exec
COPY ai-exec/package*.json /opt/ai-exec/
RUN npm ci --omit=dev
COPY ai-exec/ /opt/ai-exec/

FROM frontend-build AS frontend

COPY ./web /headlamp/web

WORKDIR /headlamp

RUN cd ./web && npm run build

RUN echo "*** Built K8S Dashboard (headlamp fork) ***"

# final 用 node:22-slim 而非 alpine:3.20——本地钉死的 alpine:3.20 只有 Node 20（< pi 要求的 22.19），
# 按 spec 回退方案换 base；ca-certificates 已随 node:22-slim 自带。
FROM node:22-slim AS final

# node:22-slim base 自带 node 用户（uid/gid 1000）：直接复用——
# 与卷内文件属主（1000:1000，早期镜像用 headlamp 用户创建）一致，免 EACCES；
# 自建 1000 会与 base 的 node 用户冲突（groupadd: GID already exists）

COPY --from=backend-build --link /headlamp/backend/headlamp-server /headlamp/headlamp-server
COPY --from=frontend --link /headlamp/web/dist /headlamp/frontend
COPY --from=ai-exec-build --link /opt/ai-exec /opt/ai-exec
COPY ./container/entrypoint.sh /headlamp/entrypoint.sh
RUN chmod +x /headlamp/entrypoint.sh \
    && chown -R node:node /headlamp /opt/ai-exec \
    && mkdir -p /data/ai /home/node/.config \
    && chown -R node:node /data/ai /home/node

USER node

# 唯一对外端口：headlamp-server（含 /ai/* → ai-exec 反代）
EXPOSE 4467

# AI 助手 LLM 网关（只被容器内 ai-exec 消费，不下发前端）。必配项：
# LLM_GATEWAY_BASE = OpenAI 兼容网关地址（…/v1）；鉴权网关另设 LLM_API_KEY。env 为底座，也可在设置页配置（即时生效）
ENV LLM_GATEWAY_BASE=""
ENV LLM_API_KEY=""
ENV LLM_MODEL=Qwen3.8-27B
# pi 数据目录（会话 JSONL / agent 配置）；建议挂载卷持久化（跨容器重建保留会话）
ENV PI_DATA_DIR=/data/ai
ENTRYPOINT ["/headlamp/entrypoint.sh"]
CMD ["-html-static-dir", "/headlamp/frontend", "-port", "4467", "--enable-helm", "--enable-dynamic-clusters", "--allow-kubeconfig-changes"]
